{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exammate-ai-coach",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash",
    "ALLOWED_ORIGINS": "https://jessielin5411-sketch.github.io,http://localhost:8787,http://127.0.0.1:8787"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "5411",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
